(fn ConstructionScript ()
  ; ===== 1. copy of BP_SmallBell's construction script (the DSL cannot call the parent's) =====
  (bind _interactcomp (Variables|Default|GetInteractComp))
  (bind _strucktag (Variables|Default|GetStruckTag))
  (bind _glyph (Variables|Default|GetGlyph))
  (Class|LBInteractableComponent|SetSingleUse true _interactcomp)
  (if (GameplayTags|IsGameplayTagValid _strucktag)
    (Class|LBInteractableComponent|SetGrantedStateTags (GameplayTags|MakeGameplayTagContainerFromTag _strucktag) _interactcomp)
    (Class|LBInteractableComponent|SetConsumedStateTag _strucktag _interactcomp))
  ; ===== 2. cloister art (D1.17 s1): actor-local, yaw 180 -> local +x is into the walk, wall plane at local x -17 =====
  (bind _post (Variables|Default|GetPost))
  (bind _arm (Variables|Default|GetArm))
  (bind _pivot (Variables|Default|GetBellPivot))
  (bind _bell (Variables|Default|GetBell))
  (bind _clapper (Variables|Default|GetClapper))
  (bind _plate (Variables|Default|GetPlate))
  ; Post = M2 bracket (slots: 0 MAT_Iron, 1 MAT_Wood)
  (Components|StaticMesh|SetStaticMesh _post "/Game/LastBell/Environments/Cloister/Meshes/SM_LB_Prop_SmallBellBracket_A.SM_LB_Prop_SmallBellBracket_A")
  (Transformation|SetRelativeLocation _post (Math|Vector|MakeVector -17.0 0.0 145.0))
  (Transformation|SetRelativeScale3D _post (Math|Vector|MakeVector 1.0 1.0 1.0))
  (Rendering|Material|SetMaterial _post 0 "/Game/LastBell/Environments/Crypt/Materials/MI_Crypt_Iron.MI_Crypt_Iron")
  (Rendering|Material|SetMaterial _post 1 "/Game/LastBell/Environments/Courtyard/Materials/MI_Prop_Wood_Weathered.MI_Prop_Wood_Weathered")
  (Collision|SetCollisionProfileName _post "NoCollision")
  (Rendering|SetVisibility _post :bNewVisibility true)
  ; Arm: hidden, no collision
  (Collision|SetCollisionProfileName _arm "NoCollision")
  (Rendering|SetVisibility _arm :bNewVisibility false)
  ; BellPivot
  (Transformation|SetRelativeLocation _pivot (Math|Vector|MakeVector 8.0 0.0 140.0))
  ; Bell = M1 (slots: 0 MAT_Bronze, 1 MAT_Iron, 2 MAT_Band); collision profile unchanged (BlockAllDynamic)
  (bind _s (Variables|Default|GetBellScale))
  (Components|StaticMesh|SetStaticMesh _bell "/Game/LastBell/Environments/Cloister/Meshes/SM_LB_Prop_SmallBell_A.SM_LB_Prop_SmallBell_A")
  (Transformation|SetRelativeLocation _bell (Math|Vector|MakeVector 0.0 0.0 -2.0))
  (Transformation|SetRelativeScale3D _bell (Math|Vector|MakeVector :X _s :Y _s :Z _s))
  (Rendering|Material|SetMaterial _bell 0 "/Game/LastBell/Environments/BellTower/Materials/MI_LB_BellBronze.MI_LB_BellBronze")
  (Rendering|Material|SetMaterial _bell 1 "/Game/LastBell/Environments/Crypt/Materials/MI_Crypt_Iron.MI_Crypt_Iron")
  (Rendering|Material|SetMaterial _bell 2 (Variables|Default|GetBandMaterial))
  (Rendering|SetVisibility _bell :bNewVisibility true)
  ; Clapper: hidden, no collision
  (Collision|SetCollisionProfileName _clapper "NoCollision")
  (Rendering|SetVisibility _clapper :bNewVisibility false)
  ; Plate = M3 plaque (slot 0 MAT_Trim)
  (Components|StaticMesh|SetStaticMesh _plate "/Game/LastBell/Environments/Cloister/Meshes/SM_LB_Prop_BellPlaque_A.SM_LB_Prop_BellPlaque_A")
  (Transformation|SetRelativeLocation _plate (Math|Vector|MakeVector -17.0 0.0 87.0))
  (Transformation|SetRelativeScale3D _plate (Math|Vector|MakeVector 1.0 1.0 1.0))
  (Rendering|Material|SetMaterial _plate 0 "/Game/LastBell/Environments/Kit/Materials/MI_Kit_Trim.MI_Kit_Trim")
  (Collision|SetCollisionProfileName _plate "NoCollision")
  (Rendering|SetVisibility _plate :bNewVisibility true)
  ; Glyph numeral on the plaque face
  (Transformation|SetRelativeLocation _glyph (Math|Vector|MakeVector -12.8 0.0 87.0))
  (Rendering|Components|TextRender|SetWorldSize _glyph 18.0)
  (Rendering|Components|TextRender|SetTextRenderColor _glyph (Utilities|Struct|MakeColor :R 26 :G 23 :B 20 :A 255))
  (Rendering|SetVisibility _glyph :bNewVisibility true)
  ; Glyph numeral from SymbolIndex (parent logic; a switch ends the flow, so it comes last)
  (switch Utilities|FlowControl|Switch|SwitchonInt (Variables|Default|GetSymbolIndex)
    (:Default
      (Rendering|Components|TextRender|SetText _glyph (Utilities|Text|MakeLiteralText "NSLOCTEXT(\"\", \"3159813740FA54FBDE8B5E8E9A77FDBE\", \"IV\")")))
    (:0
      (Rendering|Components|TextRender|SetText _glyph (Utilities|Text|MakeLiteralText "NSLOCTEXT(\"\", \"23CF93BC4E25E3718E9371B4A108D572\", \"I\")")))
    (:1
      (Rendering|Components|TextRender|SetText _glyph (Utilities|Text|MakeLiteralText "NSLOCTEXT(\"\", \"7BCD29F04C81F54D5F4D36B60F6DA470\", \"II\")")))
    (:2
      (Rendering|Components|TextRender|SetText _glyph (Utilities|Text|MakeLiteralText "NSLOCTEXT(\"\", \"981E2C7D42BDD7336A184CA40FACD8CC\", \"III\")")))))
